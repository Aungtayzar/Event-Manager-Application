<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/screen_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_eyebrow"
                android:textColor="@color/header_soft"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/screen_title"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/screen_subtitle"
                android:textColor="@color/header_soft"
                android:textSize="15sp" />
        </LinearLayout>


    <LinearLayout android:id="@+id/eventsPage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="@string/your_events" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <SearchView
            android:id="@+id/eventSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:background="@drawable/input_background"
            android:contentDescription="@string/search_events"
            android:iconifiedByDefault="false"
            android:queryHint="@string/search_name_description"
            android:inputType="text"
            android:imeOptions="actionSearch" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/advancedSearchButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="@string/advanced_search" android:textAllCaps="false" />
            <Button android:id="@+id/clearEventSearchButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:minHeight="48dp" android:text="@string/clear_search" android:textAllCaps="false" />
        </LinearLayout>
        <TextView android:id="@+id/eventFilterSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone" />
        <TextView android:id="@+id/eventSearchCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/emptyEventsText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/empty_background" android:padding="28dp" android:text="@string/empty_events" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/retryEventsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/retry" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/eventList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
    </LinearLayout>
    <ScrollView android:id="@+id/formPage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:id="@+id/eventForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/formTitle" android:text="@string/new_event"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/form_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/EventFieldLabel"
                android:labelFor="@id/eventNameInput" android:text="@string/event_name_label" />

            <EditText
                android:id="@+id/eventNameInput"
                style="@style/EventInput"
                android:hint="@string/event_name_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventNameError"
                style="@style/EventErrorText"
                android:text="@string/error_name_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:labelFor="@id/eventDateInput" android:text="@string/event_date_label" />

            <EditText
                android:id="@+id/eventDateInput"
                style="@style/EventInput"
                android:inputType="date"
                android:singleLine="true"
                android:hint="@string/event_date_hint" />

            <Button android:id="@+id/chooseDateButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="2dp" android:text="@string/choose_date" />
            <TextView
                android:id="@+id/eventDateError"
                style="@style/EventErrorText"
                android:text="@string/error_date_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:labelFor="@id/eventLocationInput" android:text="@string/event_location_label" />

            <EditText
                android:id="@+id/eventLocationInput"
                style="@style/EventInput"
                android:hint="@string/event_location_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventLocationError"
                style="@style/EventErrorText"
                android:text="@string/error_location_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:labelFor="@id/eventOrganiserInput" android:text="@string/event_organiser_label" />

            <EditText
                android:id="@+id/eventOrganiserInput"
                style="@style/EventInput"
                android:hint="@string/event_organiser_hint"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventOrganiserError"
                style="@style/EventErrorText"
                android:text="@string/error_organiser_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_type_label" />

            <Spinner
                android:id="@+id/eventTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:entries="@array/event_types"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_status_label" />

            <Spinner
                android:id="@+id/eventStatusSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:entries="@array/event_statuses"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                style="@style/EventFieldLabel"
                android:labelFor="@id/eventAmountInput" android:text="@string/event_amount_label" />

            <EditText
                android:id="@+id/eventAmountInput"
                style="@style/EventInput"
                android:hint="@string/event_amount_hint"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventAmountError"
                style="@style/EventErrorText"
                android:text="@string/error_amount" />

<TextView style="@style/EventFieldLabel" android:labelFor="@id/eventDescriptionInput" android:text="@string/description_label" />
            <EditText android:id="@+id/eventDescriptionInput" style="@style/EventInput" android:layout_height="wrap_content" android:hint="@string/description_label" android:gravity="top|start" android:minLines="3" android:paddingVertical="12dp" android:inputType="textMultiLine|textCapSentences" />
            <TextView android:id="@+id/eventDescriptionError" style="@style/EventErrorText" />
<TextView style="@style/EventFieldLabel" android:labelFor="@id/contactEmailInput" android:text="@string/email_label" />
            <EditText android:id="@+id/contactEmailInput" style="@style/EventInput" android:hint="@string/email_label" android:inputType="textEmailAddress" />
            <TextView android:id="@+id/contactEmailError" style="@style/EventErrorText" />
<TextView style="@style/EventFieldLabel" android:labelFor="@id/contactPhoneInput" android:text="@string/phone_label" />
            <EditText android:id="@+id/contactPhoneInput" style="@style/EventInput" android:hint="@string/phone_label" android:inputType="phone" />
            <TextView android:id="@+id/contactPhoneError" style="@style/EventErrorText" />
            <Button
                android:id="@+id/addEventButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/brand"
                android:text="@string/add_event"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cancelEditButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/cancel_edit"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>


    </ScrollView>
    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" app:menu="@menu/bottom_navigation" app:labelVisibilityMode="labeled" />
</LinearLayout>
