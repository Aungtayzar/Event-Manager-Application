<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_eyebrow"
                android:textColor="@color/header_soft"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/screen_title"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/screen_subtitle"
                android:textColor="@color/header_soft"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_event"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/form_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_name_label" />

            <EditText
                android:id="@+id/eventNameInput"
                style="@style/EventInput"
                android:hint="@string/event_name_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventNameError"
                style="@style/EventErrorText"
                android:text="@string/error_name_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_date_label" />

            <EditText
                android:id="@+id/eventDateInput"
                style="@style/EventInput"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/event_date_hint" />

            <TextView
                android:id="@+id/eventDateError"
                style="@style/EventErrorText"
                android:text="@string/error_date_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_location_label" />

            <EditText
                android:id="@+id/eventLocationInput"
                style="@style/EventInput"
                android:hint="@string/event_location_hint"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventLocationError"
                style="@style/EventErrorText"
                android:text="@string/error_location_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_organiser_label" />

            <EditText
                android:id="@+id/eventOrganiserInput"
                style="@style/EventInput"
                android:hint="@string/event_organiser_hint"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventOrganiserError"
                style="@style/EventErrorText"
                android:text="@string/error_organiser_required" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_type_label" />

            <Spinner
                android:id="@+id/eventTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:entries="@array/event_types"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_status_label" />

            <Spinner
                android:id="@+id/eventStatusSpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/input_background"
                android:entries="@array/event_statuses"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                style="@style/EventFieldLabel"
                android:text="@string/event_amount_label" />

            <EditText
                android:id="@+id/eventAmountInput"
                style="@style/EventInput"
                android:hint="@string/event_amount_hint"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <TextView
                android:id="@+id/eventAmountError"
                style="@style/EventErrorText"
                android:text="@string/error_amount" />

            <Button
                android:id="@+id/addEventButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/brand"
                android:text="@string/add_event"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cancelEditButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/cancel_edit"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="@string/your_events"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyEventsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/empty_background"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/empty_events"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/eventList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
